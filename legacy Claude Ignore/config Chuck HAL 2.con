name: CHUCK
board: 6x CNC Controller
stepping:
  engine: I2S_STREAM
  idle_ms: 255
  pulse_us: 4
  dir_delay_us: 1
  disable_delay_us: 0
axes:
  shared_stepper_disable_pin: NO_PIN
  x:
    steps_per_mm: 1000
    max_rate_mm_per_min: 2000
    acceleration_mm_per_sec2: 100
    max_travel_mm: 36000
    soft_limits: false
    motor0:
      limit_neg_pin: gpio.2:pu:low
      limit_pos_pin: NO_PIN
      limit_all_pin: NO_PIN
      hard_limits: true
      pulloff_mm: 10
      standard_stepper:
        step_pin: i2so.2
        direction_pin: i2so.1
        disable_pin: i2so.0
i2so:
  bck_pin: gpio.22
  data_pin: gpio.21
  ws_pin: gpio.17
start:
  must_home: false
  deactivate_parking: false
uart2:
  txd_pin: gpio.27
  rxd_pin: gpio.25
  rts_pin: NO_PIN
  cts_pin: NO_PIN
  baud: 115200
  mode: 8N1
uart_channel1:
  uart_num: 2
  report_interval_ms: 75
  message_level: Verbose
probe:
  pin: gpio.36:pu
  toolsetter_pin: no_pin
  check_mode_start: false
  hard_stop: false
